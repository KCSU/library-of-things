FLASK_ENV=development

GOOGLE_OAUTH2_CLIENT_ID=client_id
GOOGLE_OAUTH2_CLIENT_SECRET=client_secret

FLASK_SESSION_SECRET_KEY=

# Database Configuration
DATABASE_URL=

# Leave unset to turn the Lookup sync pubsub push endpoint off.
PUBSUB_PUSH_SERVICE_ACCOUNT=

# SMTP Configuration. Leave SMTP_HOST unset to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Critical alerts to the kcsu-admin alerts topic. Leave ALERTS_TOPIC unset to
# log alerts instead of publishing them.
ALERTS_TOPIC=
GOOGLE_APPLICATION_CREDENTIALS=
